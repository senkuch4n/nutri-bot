{
  "name": "nutri-bot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:bot": "npm run dev --workspace apps/bot",
    "build": "npm run build --workspace packages/core && npm run build --workspace apps/web && npm run build --workspace apps/bot",
    "db:generate": "npm run generate --workspace packages/db",
    "db:migrate": "npm run migrate --workspace packages/db",
    "db:deploy": "npm run migrate:deploy --workspace packages/db",
    "db:seed": "npm run seed --workspace packages/db",
    "db:studio": "npm run studio --workspace packages/db",
    "dev:all": "npm run db:generate && concurrently -n web,bot -c blue,green \"npm:dev\" \"npm:dev:bot\"",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
