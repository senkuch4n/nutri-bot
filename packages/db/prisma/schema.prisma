generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Fila única. Datos y configuración de la nutricionista.
model Professional {
  id                 Int      @id @default(1)
  name               String
  email              String
  phoneJid           String?
  timezone           String   @default("America/Argentina/Buenos_Aires")
  currency           String   @default("ARS")
  logoData           Bytes?
  logoMimeType       String?
  reminderLeadHours  Int      @default(24)
  /// Si está en true, el bot no responde ningún mensaje entrante.
  botPaused          Boolean  @default(false)
  googleRefreshToken String?
  googleCalendarId   String?
  googleSyncError    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Patient {
  id           String        @id @default(cuid())
  whatsappJid  String        @unique
  phone        String
  name         String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  nutritionPlans NutritionPlan[]
  clinicalRecord ClinicalRecord?
  evolutionEntries EvolutionEntry[]
}

model ClinicalRecord {
  id        String   @id @default(cuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  background String?
  goals      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EvolutionEntry {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedAt DateTime
  weightKg   Decimal? @db.Decimal(5, 2)
  heightCm   Decimal? @db.Decimal(5, 2)
  waistCm    Decimal? @db.Decimal(5, 2)
  hipCm      Decimal? @db.Decimal(5, 2)
  armCm      Decimal? @db.Decimal(5, 2)
  thighCm    Decimal? @db.Decimal(5, 2)
  calfCm     Decimal? @db.Decimal(5, 2)
  tricepsSkinfoldMm    Decimal? @db.Decimal(5, 2)
  subscapularSkinfoldMm Decimal? @db.Decimal(5, 2)
  abdominalSkinfoldMm  Decimal? @db.Decimal(5, 2)
  note       String?
  createdAt  DateTime @default(now())

  @@index([patientId, recordedAt])
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String?
  price        Decimal       @db.Decimal(12, 2)
  requiresDeposit Boolean     @default(false)
  depositKind  DepositKind?
  depositValue Decimal?      @db.Decimal(12, 2)
  durationMin  Int
  color        String        @default("#2563eb")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
}

/// Horario laboral semanal recurrente.
model AvailabilityRule {
  id        String  @id @default(cuid())
  weekday   Int // 0 = domingo .. 6 = sábado
  startTime String // "HH:mm" hora local de la profesional
  endTime   String // "HH:mm"
  active    Boolean @default(true)

  @@index([weekday])
}

enum ExceptionType {
  BLOCKED
  CUSTOM_HOURS
}

/// Excepciones puntuales: feriados, días libres, horarios especiales.
model AvailabilityException {
  id        String        @id @default(cuid())
  date      DateTime      @db.Date
  type      ExceptionType
  startTime String? // requerido si type = CUSTOM_HOURS
  endTime   String?
  reason    String?

  @@index([date])
}

enum AppointmentStatus {
  CONFIRMED
  AWAITING_PAYMENT
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum Actor {
  PATIENT
  PROFESSIONAL
}

enum DepositKind {
  FIXED
  PERCENT
}

enum PaymentKind {
  DEPOSIT
  FULL
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

model Appointment {
  id              String            @id @default(cuid())
  patient         Patient           @relation(fields: [patientId], references: [id])
  patientId       String
  service         Service           @relation(fields: [serviceId], references: [id])
  serviceId       String
  startsAt        DateTime // UTC
  endsAt          DateTime // UTC
  status          AppointmentStatus @default(CONFIRMED)
  createdBy       Actor
  cancelledBy     Actor?
  cancelReason    String?
  priceSnapshot   Decimal           @db.Decimal(12, 2)
  googleEventId   String?
  needsGoogleSync Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  messages OutboundMessage[]
  payments Payment[]

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([patientId, startsAt])
}

enum MessageKind {
  CONFIRMATION
  CANCELLATION
  REMINDER
  PROFESSIONAL_ALERT
  AD_HOC
  PLAN_PDF
  PAYMENT_LINK
}

model Payment {
  id            String        @id @default(cuid())
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String
  kind          PaymentKind
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  provider      String        @default("mercadopago")
  externalId    String?
  preferenceId  String?
  checkoutUrl   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  paidAt        DateTime?

  @@index([appointmentId])
  @@index([preferenceId])
  @@index([externalId])
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

/// Outbox: el bot es el único que envía por WhatsApp. El panel y el bot
/// encolan filas aquí y el proceso del bot las consume.
model OutboundMessage {
  id            String        @id @default(cuid())
  toJid         String
  body          String
  kind          MessageKind
  status        MessageStatus @default(PENDING)
  attempts      Int           @default(0)
  lastError     String?
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  appointmentId String?
  plan          NutritionPlan? @relation(fields: [planId], references: [id])
  planId        String?
  sentAt        DateTime?
  createdAt     DateTime      @default(now())

  // Evita duplicar confirmaciones / recordatorios para un mismo turno.
  @@unique([appointmentId, kind])
  @@index([status, createdAt])
}

enum FoodGroup {
  CEREALES
  LACTEOS
  CARNES_Y_HUEVOS
  FRUTAS
  VERDURAS
  LEGUMBRES
  GRASAS
  AZUCARES_Y_DULCES
  BEBIDAS
  OTROS
}

model Food {
  id            String    @id @default(cuid())
  name          String
  group         FoodGroup
  kcalPer100    Decimal   @db.Decimal(6, 2)
  proteinPer100 Decimal   @db.Decimal(5, 2)
  carbsPer100   Decimal   @db.Decimal(5, 2)
  fatPer100     Decimal   @db.Decimal(5, 2)
  unitHint      String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  planItems     PlanMealItem[]
  templateItems TemplateMealItem[]

  @@index([group])
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model NutritionPlan {
  id             String            @id @default(cuid())
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId      String
  title          String
  notes          String?
  status         PlanStatus        @default(DRAFT)
  pdfData        Bytes?
  pdfFileName    String?
  pdfGeneratedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  meals          PlanMeal[]
  messages       OutboundMessage[]

  @@index([patientId, status])
}

model PlanMeal {
  id     String @id @default(cuid())
  plan   NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId String
  name   String
  order  Int
  items  PlanMealItem[]

  @@index([planId, order])
}

model PlanMealItem {
  id            String    @id @default(cuid())
  meal          PlanMeal  @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId        String
  food          Food?     @relation(fields: [foodId], references: [id])
  foodId        String?
  customLabel   String?
  quantityGrams Decimal?  @db.Decimal(7, 2)
  notes         String?
  order         Int

  @@index([mealId, order])
}

model PlanTemplate {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meals     TemplateMeal[]
}

model TemplateMeal {
  id         String @id @default(cuid())
  template   PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  name       String
  order      Int
  items      TemplateMealItem[]

  @@index([templateId, order])
}

model TemplateMealItem {
  id            String       @id @default(cuid())
  meal          TemplateMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId        String
  food          Food?        @relation(fields: [foodId], references: [id])
  foodId        String?
  customLabel   String?
  quantityGrams Decimal?     @db.Decimal(7, 2)
  notes         String?
  order         Int

  @@index([mealId, order])
}

/// Máquina de estados de la conversación del bot, por paciente.
model ConversationState {
  patientJid String   @id
  step       String   @default("MENU")
  context    Json     @default("{}")
  updatedAt  DateTime @updatedAt
}

/// Estado singleton del proceso del bot: conexión y último QR.
model BotStatus {
  id              Int       @id @default(1)
  connected       Boolean   @default(false)
  qr              String?
  lastConnectedAt DateTime?
  updatedAt       DateTime  @updatedAt
}
