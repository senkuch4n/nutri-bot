generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Fila única. Datos y configuración de la nutricionista.
model Professional {
  id                 Int      @id @default(1)
  name               String
  email              String
  phoneJid           String?
  timezone           String   @default("America/Argentina/Buenos_Aires")
  currency           String   @default("ARS")
  reminderLeadHours  Int      @default(24)
  /// Si está en true, el bot no responde ningún mensaje entrante.
  botPaused          Boolean  @default(false)
  googleRefreshToken String?
  googleCalendarId   String?
  googleSyncError    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Patient {
  id           String        @id @default(cuid())
  whatsappJid  String        @unique
  phone        String
  name         String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String?
  price        Decimal       @db.Decimal(12, 2)
  durationMin  Int
  color        String        @default("#2563eb")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
}

/// Horario laboral semanal recurrente.
model AvailabilityRule {
  id        String  @id @default(cuid())
  weekday   Int // 0 = domingo .. 6 = sábado
  startTime String // "HH:mm" hora local de la profesional
  endTime   String // "HH:mm"
  active    Boolean @default(true)

  @@index([weekday])
}

enum ExceptionType {
  BLOCKED
  CUSTOM_HOURS
}

/// Excepciones puntuales: feriados, días libres, horarios especiales.
model AvailabilityException {
  id        String        @id @default(cuid())
  date      DateTime      @db.Date
  type      ExceptionType
  startTime String? // requerido si type = CUSTOM_HOURS
  endTime   String?
  reason    String?

  @@index([date])
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum Actor {
  PATIENT
  PROFESSIONAL
}

model Appointment {
  id              String            @id @default(cuid())
  patient         Patient           @relation(fields: [patientId], references: [id])
  patientId       String
  service         Service           @relation(fields: [serviceId], references: [id])
  serviceId       String
  startsAt        DateTime // UTC
  endsAt          DateTime // UTC
  status          AppointmentStatus @default(CONFIRMED)
  createdBy       Actor
  cancelledBy     Actor?
  cancelReason    String?
  priceSnapshot   Decimal           @db.Decimal(12, 2)
  googleEventId   String?
  needsGoogleSync Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  messages OutboundMessage[]

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([patientId, startsAt])
}

enum MessageKind {
  CONFIRMATION
  CANCELLATION
  REMINDER
  PROFESSIONAL_ALERT
  AD_HOC
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

/// Outbox: el bot es el único que envía por WhatsApp. El panel y el bot
/// encolan filas aquí y el proceso del bot las consume.
model OutboundMessage {
  id            String        @id @default(cuid())
  toJid         String
  body          String
  kind          MessageKind
  status        MessageStatus @default(PENDING)
  attempts      Int           @default(0)
  lastError     String?
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  appointmentId String?
  sentAt        DateTime?
  createdAt     DateTime      @default(now())

  // Evita duplicar confirmaciones / recordatorios para un mismo turno.
  @@unique([appointmentId, kind])
  @@index([status, createdAt])
}

/// Máquina de estados de la conversación del bot, por paciente.
model ConversationState {
  patientJid String   @id
  step       String   @default("MENU")
  context    Json     @default("{}")
  updatedAt  DateTime @updatedAt
}

/// Estado singleton del proceso del bot: conexión y último QR.
model BotStatus {
  id              Int       @id @default(1)
  connected       Boolean   @default(false)
  qr              String?
  lastConnectedAt DateTime?
  updatedAt       DateTime  @updatedAt
}
