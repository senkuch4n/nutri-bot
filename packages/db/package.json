{
  "name": "@nutri-bot/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./domain": "./domain/index.ts",
    "./media": "./media/recipe-photo.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "seed:demo": "dotenv -e ../../.env -- tsx prisma/seed-demo.ts",
    "seed:hu010": "dotenv -e ../../.env -- tsx prisma/seed-hu010.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit",
    "sara2:read": "tsx scripts/sara2/read-pdf.ts",
    "sara2:load": "dotenv -e ../../.env -- tsx scripts/sara2/load.ts",
    "sara2:load:prod": "tsx scripts/sara2/load.ts",
    "test:foods": "dotenv -e ../../.env -- tsx scripts/test-foods-sara2.ts",
    "test:isak": "dotenv -e ../../.env -- tsx scripts/test-isak.ts",
    "test:report": "dotenv -e ../../.env -- tsx scripts/test-anthropometric-report.ts",
    "walkthrough:hu008": "dotenv -e ../../.env -- tsx scripts/hu008-walkthrough.ts",
    "test:recipes": "dotenv -e ../../.env -- tsx scripts/test-recipes.ts",
    "recipes:extract": "dotenv -e ../../.env -- tsx scripts/recipes/extract.ts",
    "recipes:undo": "dotenv -e ../../.env -- tsx scripts/recipes/undo.ts",
    "recipes:export": "dotenv -e ../../.env -- tsx scripts/recipes/export.ts",
    "recipes:import:prod": "tsx scripts/recipes/import.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nutri-bot/core": "*",
    "@prisma/client": "^5.22.0",
    "googleapis": "^144.0.0",
    "mercadopago": "^3.6.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
