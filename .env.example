# --- Base de datos ---
# DB_PORT es el puerto del host para el Postgres de docker-compose (cambialo si el 5432 está ocupado).
DB_PORT=5432
DATABASE_URL=postgresql://nutri:nutri@localhost:5432/nutribot

# --- Auth.js (panel web) ---
AUTH_SECRET=cambiar-esto-por-un-string-aleatorio-largo
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Emails con acceso al panel, separados por coma
ALLOWED_EMAILS=joelserrudo@gmail.com

# --- Dominio ---
PROFESSIONAL_TZ=America/Argentina/Buenos_Aires
CURRENCY=ARS
REMINDER_LEAD_HOURS=24
MIN_LEAD_MINUTES=120

# --- Bot (Baileys) ---
BOT_POLL_INTERVAL_MS=4000
# Minutos de inactividad tras los que una conversación abierta vuelve a "dormida"
# (el bot solo responde de nuevo con una palabra clave: turno, menú, etc.)
BOT_SESSION_TIMEOUT_MIN=20
WHATSAPP_AUTH_DIR=./.whatsapp-auth
# JID de la profesional para recibir alertas (formato 549XXXXXXXXXX@s.whatsapp.net)
PROFESSIONAL_JID=

# --- Mercado Pago ---
# Access token de Mercado Pago (Checkout Pro). Sandbox mientras se prueba, producción para cobrar de verdad.
MERCADOPAGO_ACCESS_TOKEN=
