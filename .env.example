# --- Base de datos ---
# DB_PORT es el puerto del host para el Postgres de docker-compose (cambialo si el 5432 está ocupado).
DB_PORT=5432
DATABASE_URL=postgresql://nutri:nutri@localhost:5432/nutribot

# --- Auth.js (panel web) ---
AUTH_SECRET=cambiar-esto-por-un-string-aleatorio-largo
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# El acceso al panel no se configura acá: es por membresía en la base (HU-025). Después del primer
# login con Google, la cuenta queda pendiente y se le da acceso con
#   npm run tenant-access --workspace packages/db -- grant --email <email> --tenant legacy-tenant --role OWNER --apply
# (con DATABASE_URL exportada). Ver README, "Acceso al panel".
# Clave para cifrar el token de Google Calendar (y futuras integraciones): openssl rand -base64 32.
# Si se cambia, cada consultorio tiene que reconectar Google Calendar.
INTEGRATION_TOKEN_KEY=
# Redirect URI a cargar en Google Cloud: <AUTH_URL>/api/google-calendar/oauth/callback

# --- Dominio ---
PROFESSIONAL_TZ=America/Argentina/Buenos_Aires
CURRENCY=ARS
REMINDER_LEAD_HOURS=24
MIN_LEAD_MINUTES=120

# --- Bot (Baileys) ---
BOT_POLL_INTERVAL_MS=4000
# Minutos de inactividad tras los que una conversación abierta vuelve a "dormida"
# (el bot solo responde de nuevo con una palabra clave: turno, menú, etc.)
BOT_SESSION_TIMEOUT_MIN=20
WHATSAPP_AUTH_DIR=./.whatsapp-auth
# JID de la profesional para recibir alertas (formato 549XXXXXXXXXX@s.whatsapp.net)
PROFESSIONAL_JID=

# --- Mercado Pago ---
# Aplicación "Numa" del equipo (Mercado Pago Developers → Tus integraciones → Numa).
# Cada consultorio (su OWNER) conecta SU cuenta desde Ajustes → Mercado Pago (OAuth). Ver README.
# Una misma cuenta de Mercado Pago no puede estar conectada en dos consultorios (HU-028a).
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Clave para cifrar los tokens de la cuenta vinculada: 32 bytes en base64 (openssl rand -base64 32).
# Si se cambia, hay que reconectar Mercado Pago desde Ajustes.
MERCADOPAGO_TOKEN_KEY=
# La redirect URI no va acá: es <AUTH_URL>/api/mercadopago/oauth/callback y tiene que estar
# cargada tal cual en "URLs de redireccionamiento" de la aplicación.
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=
MERCADOPAGO_RETURN_URL=
# Solo desarrollo: si el consultorio original no tiene cuenta vinculada, usar este access token.
# Se ignora con NODE_ENV=production y en cualquier otro consultorio.
MERCADOPAGO_ALLOW_ENV_TOKEN=false
MERCADOPAGO_ACCESS_TOKEN=
# HU-029: user_id de la cuenta de cobro de Arzium (suscripción). Esa cuenta nunca se acepta como cuenta
# de señas de un consultorio. Nunca poner acá la cuenta de un consultorio. Vacía = sin restricción.
ARZIUM_MERCADOPAGO_USER_ID=

# --- Suscripciones de Arzium (HU-029) ---
# Cobro de la suscripción mensual de Numa con la cuenta y la aplicación de Mercado Pago de ARZIUM:
# nunca la cuenta de un consultorio. Apagado por defecto: solo "true" habilita; con cualquier otro valor
# la pantalla dice "todavía no está disponible", el webhook ignora y la conciliación del bot no consulta nada.
# Habilitarlo requiere TODAS estas variables (si falta alguna, queda apagado y se loguea qué nombre falta).
ARZIUM_SUBSCRIPTIONS_ENABLED=false
# "sandbox" (solo fuera de producción, con usuarios de prueba) o "live" (solo con NODE_ENV=production).
ARZIUM_MERCADOPAGO_MODE=
# Access token de la aplicación de MP de Arzium. Solo lo lee packages/db/domain/subscriptionsGateway.ts.
ARZIUM_MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de la aplicación de MP de Arzium (firma x-signature del webhook
# /api/webhooks/mercadopago-suscripciones). Distinta de MERCADOPAGO_WEBHOOK_SECRET (señas).
ARZIUM_MERCADOPAGO_WEBHOOK_SECRET=
# Opcional: vuelta del checkout. Por defecto ${AUTH_URL}/ajustes/suscripcion?mp=volver. En desarrollo,
# la URL https de un túnel (MP no acepta localhost).
ARZIUM_SUBSCRIPTIONS_BACK_URL=

# --- Asistente con IA (DeepSeek) ---
# API key de DeepSeek (platform.deepseek.com). Usa el modelo deepseek-chat.
API_KEY_IA_DEEPSEEK=

# IA del bot de pacientes (HU-012). Sin la clave, la opción 5 no aparece.
API_KEY_IA_ANTHROPIC=
# BOT_AI_PROVIDER=anthropic          # o deepseek (usa API_KEY_IA_DEEPSEEK)
# BOT_AI_MODEL=claude-haiku-4-5
# Topes diarios: default de cada consultorio (HU-028c). Arzium puede fijar topes propios por consultorio con
# `npm run ai-limits --workspace packages/db`; sin valor propio, el consultorio usa estos.
# BOT_AI_DAILY_PER_PATIENT=20
# BOT_AI_DAILY_GLOBAL=300            # tope diario POR CONSULTORIO (el nombre se conserva)
# BOT_AI_MAX_CHARS=500
# BOT_AI_HISTORY_TURNS=6
# BOT_AI_MAX_TOKENS=300
# BOT_AI_MAX_TOOL_ROUNDS=4
# BOT_AI_TIMEOUT_MS=20000
# BOT_AI_DEADLINE_MS=30000
# BOT_AI_RETENTION_DAYS=90
