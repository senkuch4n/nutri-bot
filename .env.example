# --- Base de datos ---
# DB_PORT es el puerto del host para el Postgres de docker-compose (cambialo si el 5432 está ocupado).
DB_PORT=5432
DATABASE_URL=postgresql://nutri:nutri@localhost:5432/nutribot

# --- Auth.js (panel web) ---
AUTH_SECRET=cambiar-esto-por-un-string-aleatorio-largo
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Emails con acceso al panel, separados por coma
ALLOWED_EMAILS=joelserrudo@gmail.com
# Cuenta de Google cuyo calendario sincroniza el bot. Solo el login de esta cuenta guarda el
# token del calendario (los demás emails de ALLOWED_EMAILS entran al panel sin pisarlo).
# Sin definir: se guarda solo si no hay token todavía o si la sincronización está fallando.
GOOGLE_CALENDAR_OWNER_EMAIL=

# --- Dominio ---
PROFESSIONAL_TZ=America/Argentina/Buenos_Aires
CURRENCY=ARS
REMINDER_LEAD_HOURS=24
MIN_LEAD_MINUTES=120

# --- Bot (Baileys) ---
BOT_POLL_INTERVAL_MS=4000
# Minutos de inactividad tras los que una conversación abierta vuelve a "dormida"
# (el bot solo responde de nuevo con una palabra clave: turno, menú, etc.)
BOT_SESSION_TIMEOUT_MIN=20
WHATSAPP_AUTH_DIR=./.whatsapp-auth
# JID de la profesional para recibir alertas (formato 549XXXXXXXXXX@s.whatsapp.net)
PROFESSIONAL_JID=

# --- Mercado Pago ---
# Aplicación "Numa" del equipo (Mercado Pago Developers → Tus integraciones → Numa).
# La profesional conecta SU cuenta desde Ajustes → Mercado Pago (OAuth). Ver README.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Clave para cifrar los tokens de la cuenta vinculada: 32 bytes en base64 (openssl rand -base64 32).
# Si se cambia, hay que reconectar Mercado Pago desde Ajustes.
MERCADOPAGO_TOKEN_KEY=
# La redirect URI no va acá: es <AUTH_URL>/api/mercadopago/oauth/callback y tiene que estar
# cargada tal cual en "URLs de redireccionamiento" de la aplicación.
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=
MERCADOPAGO_RETURN_URL=
# Solo desarrollo: si no hay cuenta vinculada, usar este access token. Se ignora con NODE_ENV=production.
MERCADOPAGO_ALLOW_ENV_TOKEN=false
MERCADOPAGO_ACCESS_TOKEN=

# --- Asistente con IA (DeepSeek) ---
# API key de DeepSeek (platform.deepseek.com). Usa el modelo deepseek-chat.
API_KEY_IA_DEEPSEEK=

# IA del bot de pacientes (HU-012). Sin la clave, la opción 5 no aparece.
API_KEY_IA_ANTHROPIC=
# BOT_AI_PROVIDER=anthropic          # o deepseek (usa API_KEY_IA_DEEPSEEK)
# BOT_AI_MODEL=claude-haiku-4-5
# BOT_AI_DAILY_PER_PATIENT=20
# BOT_AI_DAILY_GLOBAL=300
# BOT_AI_MAX_CHARS=500
# BOT_AI_HISTORY_TURNS=6
# BOT_AI_MAX_TOKENS=300
# BOT_AI_MAX_TOOL_ROUNDS=4
# BOT_AI_TIMEOUT_MS=20000
# BOT_AI_DEADLINE_MS=30000
# BOT_AI_RETENTION_DAYS=90
